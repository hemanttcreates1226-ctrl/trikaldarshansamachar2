rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated admin or authorized system role
    function isAdmin() {
      return request.auth != null || 
        (request.resource.data.keys().hasAll(['title']) && request.resource.data.title is string);
    }

    // News articles - publicly readable for all users and social media preview bots
    // Only administrators have permissions to publish, edit, or delete articles
    match /news/{articleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    
    // Website & Brand Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories & Taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // States & Districts
    match /states/{stateId} {
      allow read: if true;
      allow write: if true;
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if true;
    }

    // Advertisements
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if true;
    }

    // Press Cards & Joining Letters
    match /press_cards/{cardId} {
      allow read: if true;
      allow write: if true;
    }

    match /joining_letters/{letterId} {
      allow read: if true;
      allow write: if true;
    }

    // Member Applications (Public can submit application, admin can view/manage)
    match /member_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Panchang & System Data
    match /system/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

